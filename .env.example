# Copy this file to .env (same folder) and fill in your Turso details.
# Get them with: turso db show <db-name> --url   and   turso db tokens create <db-name>
# On Vercel, set the same two variables in Project Settings -> Environment Variables.
TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-YOUR-ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_TOKEN
